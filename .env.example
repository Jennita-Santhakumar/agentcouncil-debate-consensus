# LLM provider: "ollama" (default, local, free) or "anthropic" (paid API, higher quality)
LLM_PROVIDER=ollama

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# From inside Docker containers, reach a native-Windows Ollama install via
# host.docker.internal, NOT 127.0.0.1/localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

DATABASE_URL=postgresql+psycopg://debate:debate@localhost:5512/debate

CORS_ORIGINS=http://localhost:5300
